.env
__pycache__/
*.pyc
scraper/state.json
.venv/
.pytest_cache/

# Batch result store (idempotency + async state) -- rebuilt on demand
data/batches.sqlite3
data/batches.sqlite3-wal
data/batches.sqlite3-shm

# Saved eval runs: keep the ones you want to compare, don't commit every run
data/runs/

# --- third-party corpus (github.com/javohirmat/uzbek-legal-corpus, CC0) ------
# Only the two things /v1 reads are committed: the article JSONL files and the
# manifest. They are pinned on purpose -- `index_version` claims snapshot
# 2026-07, and a teammate cloning a newer corpus would silently change the index
# and make their eval scores incomparable with ours.
#
# Everything else from that repo is excluded: its own .git (5MB, and a nested
# repo breaks `git add`), its agent/skill directories (third-party executable
# content we did not review), its demo RAG code, and its 8.8MB of raw .txt
# source, which nothing here reads.
data/corpus/**/.git/
data/corpus/**/.claude/
data/corpus/**/.agents/
data/corpus/**/.gitignore
data/corpus/uzbek-legal-corpus/rag/
data/corpus/uzbek-legal-corpus/scripts/
data/corpus/uzbek-legal-corpus/data/raw/
data/corpus/uzbek-legal-corpus/skills-lock.json
