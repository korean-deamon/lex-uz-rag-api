.env
__pycache__/
*.pyc
scraper/state.json
.venv/
.pytest_cache/

# Batch result store (idempotency + async state) -- rebuilt on demand
data/batches.sqlite3
data/batches.sqlite3-wal
data/batches.sqlite3-shm

# Saved eval runs: keep the ones you want to compare, don't commit every run
data/runs/

# PDFs stay local. The exported write-ups go stale the moment the code moves on,
# and the write-up itself lives in README.md and TESTING.md.
*.pdf

# --- third-party corpus (github.com/javohirmat/uzbek-legal-corpus, CC0) ------
# Only the two things /v1 reads are committed: the article JSONL files and the
# manifest. They are pinned on purpose -- `index_version` claims snapshot
# 2026-07, and a teammate cloning a newer corpus would silently change the index
# and make their eval scores incomparable with ours.
#
# Everything else from that repo is excluded, and deleted locally too: its own
# .git (a nested repo makes `git add` commit a pointer instead of the files),
# its agent/skill directories (third-party executable content we did not
# review), its demo RAG code, and its 8.8 MB of raw .txt source. Only
# scripts/build_section_titles.py ever read the raw text, and its output
# (data/section_titles.json) is committed -- re-fetch the corpus at the commit
# in data/corpus/CORPUS_SOURCE.md if you need to regenerate it.
data/corpus/**/.git/
data/corpus/**/.claude/
data/corpus/**/.agents/
data/corpus/**/.gitignore
data/corpus/uzbek-legal-corpus/rag/
data/corpus/uzbek-legal-corpus/scripts/
data/corpus/uzbek-legal-corpus/data/raw/
data/corpus/uzbek-legal-corpus/skills-lock.json
