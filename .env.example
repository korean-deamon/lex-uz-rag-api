# Copy this file to .env and fill in real values. Never commit the real .env.

# Must be a Console API key (sk-ant-api03-...). A Claude Code subscription
# OAuth token (sk-ant-oat01-...) authenticates but is rate-limited on the
# Messages API and returns 429, so generation will fail with LLM_ERROR.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=lex_uz

# base listing page(s) we crawl for document links
LEX_BASE_URL=https://lex.uz/uz/

# --- /v1 RAG API ------------------------------------------------------------
# Test key(s) for the evaluation, comma-separated. Keep this separate from any
# production key, per spec section 2.
RAG_API_KEYS=test-key-lex-2026

# Which provider generates the answers. Retrieval is identical for all of them.
#   anthropic | gemini | groq | offline
# "offline" is the deterministic extractive answerer: no credential, no cost,
# but no no_answer judgement and no answer_language support. The contract tests
# use it; it is also the right setting while you are waiting for a key.
#
# It is the default here on purpose, so `cp .env.example .env` gives a setup
# that works immediately. Switch it to your provider once you have a key --
# selecting a provider without its key fails every question with LLM_ERROR.
RAG_LLM_BACKEND=offline

# One model id per provider, since each names its models differently.
# `python scripts/list_models.py <provider>` prints what your key can reach.
RAG_ANTHROPIC_MODEL=claude-haiku-5-5
RAG_GEMINI_MODEL=gemini-2.0-flash
RAG_GROQ_MODEL=llama-3.3-70b-versatile

# Only the key for the provider you selected above needs to be set.
GEMINI_API_KEY=
GROQ_API_KEY=

# Bump PIPELINE_VERSION whenever retrieval or prompting changes, or two runs
# with different behaviour will look identical when compared.
PIPELINE_VERSION=1.0.0
INDEX_VERSION=lex-idx-2026-07-corpus-25
LEX_SNAPSHOT_DATE=2026-07-01

# Spec limits; lower RAG_SYNC_DEADLINE_S to exercise the async 202 path.
RAG_SYNC_DEADLINE_S=120
RAG_RATE_LIMIT_INTERVAL_S=1.0
RAG_RESULT_RETENTION_DAYS=30
